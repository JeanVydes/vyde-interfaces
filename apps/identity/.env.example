# The gateway. Never the identity service: it is behind the gateway and holds no cookie.
#
# A different subdomain from this app in development *and* in production, which is the point. The
# browser therefore issues a CORS preflight and attaches the session cookie cross-origin — the two
# things development has to exercise that it cannot when everything is served from one origin.
#
# Must be listed in the gateway's `GATEWAY_CORS_ALLOW_ORIGINS`, or every request is refused.
VITE_API_URL=https://api.vyde.test:8443

# Where other apps may send the user after they authenticate here. Comma-separated exact origins,
# compared structurally — see `@vyde/auth-client`'s return-to validator, which is the open-redirect
# gate and the only thing standing between a `?return_to=` parameter and an open redirect.
#
# The list is an allowlist, not a suffix: `https://evil-vyde.dev` is refused, and so is anything
# that is merely a prefix of a listed origin. A malformed entry is dropped with a warning rather
# than quietly matching nothing later.
VITE_ALLOWED_RETURN_ORIGINS=https://identity.vyde.test:5173,https://console.vyde.test:5173,https://research.vyde.test:5173

# This app's own origin — the default destination when a `return_to` is refused, so a rejected
# redirect lands here rather than nowhere.
VITE_APP_ORIGIN=https://identity.vyde.test:5173

# Left empty: the appearance follows the operating system until the account says otherwise.
# Set to `red`, `amber`, `green` or `cyan` to pin the accent while developing a theme, without
# touching the account's stored preference.
VITE_DEFAULT_ACCENT=